[Unit]
# Never stop restarting it, however often it crashes.
StartLimitIntervalSec=0
Description=Copy EasyEffects output to every connected Bluetooth speaker
After=pipewire.service wireplumber.service easyeffects.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/ee8-bt-mirror.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
