[Unit]
# Never stop restarting it, however often it crashes.
StartLimitIntervalSec=0
Description=Second Bluetooth speaker follows the volume keys
After=pipewire.service wireplumber.service easyeffects.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/ee8-volume-follow.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
